# API Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api
NEXT_PUBLIC_UPLOAD_BASE_URL=http://localhost:8080/uploads

# File Upload Limits
NEXT_PUBLIC_MAX_IMAGE_SIZE=5242880      # 5MB
NEXT_PUBLIC_MAX_VIDEO_SIZE=52428800     # 50MB
NEXT_PUBLIC_MAX_IMAGES=5
NEXT_PUBLIC_MAX_VIDEOS=2

# Authentication Configuration
NEXT_PUBLIC_TOKEN_EXPIRE_TIME=86400000  # 24 hours (milliseconds)
NEXT_PUBLIC_REFRESH_TOKEN_EXPIRE_TIME=604800000  # 7 days (milliseconds)

# Feature Flags
NEXT_PUBLIC_ENABLE_VIDEO_UPLOAD=true
NEXT_PUBLIC_ENABLE_NOTIFICATIONS=false
